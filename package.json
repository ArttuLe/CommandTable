{
  "name": "command-table",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "host": "tsx scripts/host.ts",
    "dev": "tsx scripts/dev.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "concurrently": "^10.0.5",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
